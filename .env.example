# ==============================================================
# AI-ERGO Environment Configuration Template
# ==============================================================

# Application Settings
APP_NAME="AI-ERGO System"
APP_ENV=production
APP_DEBUG=false
APP_PORT=8085
APP_TIMEZONE=Asia/Jakarta

# Jika diakses lewat Cloudflare Domain (contoh: https://ergo.domainkamu.com),
# ganti URL berikut sesuai domain Cloudflare Anda:
APP_URL=http://localhost:8085

# Database Configuration (Docker container service 'db')
DB_HOST=db
DB_PORT=3306
DB_NAME=ai_ergo
DB_USER=ai_ergo_user
DB_PASS=ai_ergo_secret
DB_ROOT_PASSWORD=root_super_secret

# AI & LLM Engine Settings
AI_DEFAULT_PROVIDER=gemini
GEMINI_API_KEY=
GROQ_API_KEY=
AI_TEMPERATURE=0.7
AI_MAX_TOKENS=2048

# Cloudflare Tunnel Token (Opsional, jika memakai service tunnel di docker-compose)
CLOUDFLARE_TUNNEL_TOKEN=
